# Python virtual environment
venv/
/env/

# Python cache files
__pycache__/
*.pyc

# Build and packaging artefacts
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# IDE and OS-specific files
.vscode/
.idea/
.DS_Store

# Data and Output Folders
# Ignore all contents of the input_data folder...
input_data/*
# ...but DO NOT ignore the README file inside it.
!input_data/README.md
# Ignore all contents of the output folder (no readme in there)
output/*

# Model weights are distributed separately, not via GitHub.
# Download them and place them in models/ - see README.
models/*
!models/README.md

*.zip
*.tar.gz
